# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local tooling and temporary artifacts
/.tools/
/tmp/

# prototype-generated artifacts
/prototypes/**/node_modules/
/prototypes/**/dist/
/prototypes/**/tmp/
/prototypes/**/.preview/
/prototypes/**/*.tar.gz

# supabase local CLI metadata
/supabase/.temp/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
