# Supabase — reuse the SAME project as the Next app. Anon key = the publishable
# key. These also fall back to the Next NEXT_PUBLIC_* names if you copy them.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role secret — bypasses RLS. Used ONLY by POST /cron/:job. Never expose.
SUPABASE_SECRET_KEY=

# Shared secret guarding POST /cron/:job (must match the scheduler's Bearer).
CRON_SECRET=

# Resend API key for reminder emails (optional; email is best-effort).
RESEND_API_KEY=

# Absolute origin used in reminder-email links. Defaults to http://localhost:3000.
SITE_URL=

# Port the API listens on.
PORT=4000

# Browser origin(s) allowed by CORS (comma-separated). The Next app in dev.
ALLOWED_ORIGIN=http://localhost:3000
