{
  "name": "destiny",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && opennextjs-cloudflare build --skipNextBuild && node scripts/prepare-sites-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:seed": "tsx scripts/generate-seed-sql.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:remote": "node --experimental-websocket --import tsx scripts/seed-remote.ts",
    "rls:test": "node --experimental-websocket --import tsx scripts/rls-test-remote.ts",
    "dev:login": "node --experimental-websocket --import tsx scripts/dev-login.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.10",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  }
}
