NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
CRON_SECRET=

# Base URL of the standalone Express API (backend/). The browser and Server
# Components both call it through lib/api/client.ts. Must be NEXT_PUBLIC_* to
# reach the client bundle. Defaults to http://localhost:4000 when unset.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Absolute origin used in reminder-email links (app/api/cron/[job]/route.ts).
# Defaults to http://localhost:3000 when unset.
SITE_URL=

# Project ref of the dev project — the bare id from the Supabase URL, e.g.
# abcdefghijklmnopqrst in https://abcdefghijklmnopqrst.supabase.co.
# scripts/dev-env.ts refuses to run the seeding, dev-login and RLS-test scripts
# against any project whose URL doesn't contain this value (P10-3).
SUPABASE_DEV_PROJECT_REF=
