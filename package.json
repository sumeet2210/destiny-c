{
  "name": "destiny",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "vinext build && node scripts/prepare-sites-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:seed": "tsx scripts/generate-seed-sql.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:remote": "node --experimental-websocket --import tsx scripts/seed-remote.ts",
    "rls:test": "node --experimental-websocket --import tsx scripts/rls-test-remote.ts",
    "dev:login": "node --experimental-websocket --import tsx scripts/dev-login.ts",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.1",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "server-only": "^0.0.1",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.10",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  },
  "type": "module"
}
